# ==================================================
# SPØR - EAS BUILD IGNORE
# Keep this file at the repository root.
# ==================================================

# --------------------------------------------------
# Git metadata / history
# --------------------------------------------------

.git
.git/**
/.git
/.git/**

# --------------------------------------------------
# Dependencies
# EAS installs these from package.json/package-lock.json
# --------------------------------------------------

node_modules
node_modules/**
**/node_modules
**/node_modules/**

# --------------------------------------------------
# EAS / Expo local state
# --------------------------------------------------

.eas-inspect
.eas-inspect/**
**/.eas-inspect
**/.eas-inspect/**

.expo
.expo/**
**/.expo
**/.expo/**

# --------------------------------------------------
# Design / reference material
# Not required by the Android application
# --------------------------------------------------

docs
docs/**
/docs
/docs/**

# --------------------------------------------------
# Rust / Solana build artifacts
# Keep programs/spore SOURCE, exclude compiled output
# --------------------------------------------------

target
target/**
**/target
**/target/**

# --------------------------------------------------
# Next.js / API build output
# Keep apps/api source; exclude generated output
# --------------------------------------------------

.next
.next/**
**/.next
**/.next/**

# --------------------------------------------------
# Generic generated build output
# --------------------------------------------------

dist
dist/**
**/dist
**/dist/**

build
build/**
**/build
**/build/**

coverage
coverage/**
**/coverage
**/coverage/**

.cache
.cache/**
**/.cache
**/.cache/**

.turbo
.turbo/**
**/.turbo
**/.turbo/**

# --------------------------------------------------
# Vercel local metadata
# --------------------------------------------------

.vercel
.vercel/**
**/.vercel
**/.vercel/**

# --------------------------------------------------
# Logs / temporary files
# --------------------------------------------------

*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

tmp
tmp/**
**/tmp
**/tmp/**

temp
temp/**
**/temp
**/temp/**

# --------------------------------------------------
# Local environment files
# Build-time EXPO_PUBLIC values are in eas.json
# Keep examples/templates
# --------------------------------------------------

.env
.env.*
**/.env
**/.env.*
*.env
*.env.*
**/*.env
**/*.env.*

!.env.example
!**/.env.example
!*env.example
!**/*env.example

# Generated devnet environments and keypairs are local-only.
scripts/devnet/.generated
scripts/devnet/.generated/**
**/scripts/devnet/.generated
**/scripts/devnet/.generated/**

# --------------------------------------------------
# Sensitive key material
# Never upload local wallets / keypairs / secrets
# --------------------------------------------------

*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Common local Solana keypair naming patterns
*-keypair.json
*keypair*.json
**/*-keypair.json
**/*keypair*.json
**/id.json
**/*-authority.json
**/*authority*.json
**/*-sponsor.json
**/*sponsor*.json
**/program-buffer.json
**/program-clean-buffer.json

# Other local credential dumps sometimes created by wallets / CLIs
*.secret
*.secret.*
**/*.secret
**/*.secret.*

# --------------------------------------------------
# Editor / OS junk
# --------------------------------------------------

.DS_Store
**/.DS_Store

Thumbs.db
**/Thumbs.db

.vscode
.vscode/**
**/.vscode
**/.vscode/**

.idea
.idea/**
**/.idea
**/.idea/**

# --------------------------------------------------
# Misc local files
# --------------------------------------------------

*.swp
*.swo
*~
