# DEVNET-ONLY API environment for the fresh SPORE devnet.
# Copy secret values from scripts/devnet/.generated/fresh-devnet/api.devnet.secrets.env into the devnet host only.

MONGODB_URI=mongodb+srv://<DEVNET_MONGODB_USER>:<DEVNET_MONGODB_PASSWORD>@<DEVNET_MONGODB_CLUSTER>/spor_devnet_fresh?retryWrites=true&w=majority
HELIUS_API_KEY=<DEVNET_HELIUS_API_KEY>
SIWS_DOMAIN=<DEVNET_API_HOST>
SIWS_URI=<DEVNET_API_URL>
SPORE_ENV=devnet
SPORE_SOLANA_CLUSTER=devnet
SPORE_PROGRAM_ID=9HvZ7ckadQt38R1KxYPhP759yCCx4MRF8NBquV4HUUXZ
SPORE_REPRODUCTION_MODE=server
SPORE_VERBOSE_SOLANA_DIAGNOSTICS=false
HELIUS_WEBHOOK_AUTH=<DEVNET_ONLY_WEBHOOK_AUTH>

SPORE_TREASURY=<DEVNET_TREASURY_PUBLIC_KEY>
SPORE_BIRTH_FEE_LAMPORTS=<DEVNET_BIRTH_FEE_LAMPORTS>
SPORE_METADATA_BASE_URI=<DEVNET_API_URL>
SPORE_SERVER_AUTHORITY_SECRET=<DEVNET_SERVER_AUTHORITY_JSON_SECRET_KEY>
SPORE_ASSET_DERIVATION_SECRET=<DEVNET_ASSET_DERIVATION_SECRET>

# Devnet-only Test SGT support. Never copy these values to mainnet.
SPORE_DEVNET_TEST_SGT_BOOTSTRAP_ENABLED=true
SPORE_DEVNET_APPROVED_PROGRAM_ID=9HvZ7ckadQt38R1KxYPhP759yCCx4MRF8NBquV4HUUXZ
SPORE_DEVNET_TEST_SGT_MINT_AUTHORITY=F4sYop49na9Mgy2xBricUgq5YVgNXYX5n4BZWHfXXtnY
SPORE_DEVNET_TEST_SGT_METADATA_ADDRESS=C7htVBfxMFUEYVai6s2haQqQkoce5y31mpk8a3r8sBW4
SPORE_DEVNET_TEST_SGT_GROUP_ADDRESS=C7htVBfxMFUEYVai6s2haQqQkoce5y31mpk8a3r8sBW4
SPORE_DEVNET_SPONSOR_PUBLIC_KEY=Fktdbq1aKgTsrMQnVVWy49u4rmRi1xzAX9aMrGS4dw5P
SPORE_DEVNET_TEST_SGT_MINT_AUTHORITY_SECRET=<COPY_FROM_GENERATED_API_DEVNET_SECRETS_ENV>
SPORE_DEVNET_SPONSOR_SECRET=<COPY_FROM_GENERATED_API_DEVNET_SECRETS_ENV>
SPORE_DEVNET_TESTER_FUNDING_TARGET_LAMPORTS=100000000

# NO MAINNET CUSTOM SPØR PROGRAM DEPLOYMENT IS REQUIRED.
# SPORE_PROGRAM_ID is a stable logical namespace in server reproduction mode.
