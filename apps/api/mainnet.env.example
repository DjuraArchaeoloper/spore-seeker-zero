# MAINNET API environment for server-era SPØR production.
# NO MAINNET CUSTOM SPØR PROGRAM DEPLOYMENT IS REQUIRED.
# SPORE_PROGRAM_ID is a stable logical namespace used to derive organism identities.

SPORE_ENV=mainnet
SPORE_SOLANA_CLUSTER=mainnet
SPORE_REPRODUCTION_MODE=server
SPORE_VERBOSE_SOLANA_DIAGNOSTICS=false
SPORE_MIGRATION_MAINTENANCE=false

MONGODB_URI=mongodb+srv://<MAINNET_MONGODB_USER>:<MAINNET_MONGODB_PASSWORD>@<MAINNET_MONGODB_CLUSTER>/spor_mainnet?retryWrites=true&w=majority
HELIUS_API_KEY=<MAINNET_HELIUS_API_KEY>
HELIUS_WEBHOOK_AUTH=<MAINNET_WEBHOOK_AUTH>

SIWS_DOMAIN=<PRODUCTION_API_HOST>
SIWS_URI=https://<PRODUCTION_API_HOST>

# Separate web-admin authentication. Set one approved email initially.
ADMIN_EMAILS=<APPROVED_ADMIN_EMAIL>
ADMIN_OTP_SECRET=<AT_LEAST_32_RANDOM_CHARACTERS>
RESEND_API_KEY=<RESEND_API_KEY>
ADMIN_EMAIL_FROM=<VERIFIED_SENDER_EMAIL>
SPORE_SKR_MINT=<MAINNET_SKR_TOKEN_MINT>
SPORE_SKR_TREASURY_WALLET=<MAINNET_TREASURY_WALLET_PUBLIC_KEY>

SPORE_PROGRAM_ID=<STABLE_LOGICAL_NAMESPACE_PUBLIC_KEY>
SPORE_TREASURY=<PRODUCTION_TREASURY_PUBLIC_KEY>
SPORE_BIRTH_FEE_LAMPORTS=<PRODUCTION_BIRTH_FEE_LAMPORTS>
SPORE_METADATA_BASE_URI=https://<PRODUCTION_API_HOST>

SPORE_SERVER_AUTHORITY_SECRET=<PRODUCTION_SERVER_AUTHORITY_JSON_SECRET_KEY>
SPORE_ASSET_DERIVATION_SECRET=<PRODUCTION_ASSET_DERIVATION_SECRET_DISTINCT_FROM_SERVER_AUTHORITY>

# One-time Seeker Zero bootstrap script inputs. Keep unset in normal API runtime.
SPORE_BOOTSTRAP_SEEKER_ZERO=false
SPORE_BOOTSTRAP_SEEKER_ZERO_SGT=<SEEKER_ZERO_SGT_MINT>
SPORE_BOOTSTRAP_SEEKER_ZERO_WALLET=<SEEKER_ZERO_OWNER_WALLET>

SPOR_SOCIAL_SECRET=<PRODUCTION_SOCIAL_SECRET>
CRON_SECRET=<PRODUCTION_CRON_SECRET>
X_API_KEY=<PRODUCTION_X_API_KEY>
X_API_KEY_SECRET=<PRODUCTION_X_API_KEY_SECRET>
X_ACCESS_TOKEN=<PRODUCTION_X_ACCESS_TOKEN>
X_ACCESS_TOKEN_SECRET=<PRODUCTION_X_ACCESS_TOKEN_SECRET>
