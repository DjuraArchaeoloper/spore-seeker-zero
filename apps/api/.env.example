MONGODB_URI=
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH=

SIWS_DOMAIN=
SIWS_URI=

# mainnet | devnet — REQUIRED (no silent default). Preview/devnet must be "devnet".
SPORE_SOLANA_CLUSTER=devnet
# Logical organism-identity seed program id (compatibility). Not used for server-era births.
SPORE_PROGRAM_ID=

# server (default) | anchor_legacy
SPORE_REPRODUCTION_MODE=server

# Canonical species economics / metadata (also required for Seeker Zero bootstrap)
SPORE_TREASURY=
SPORE_BIRTH_FEE_LAMPORTS=
SPORE_METADATA_BASE_URI=

# Server Core authority (JSON secret-key byte array). Never ship to mobile.
SPORE_SERVER_AUTHORITY_SECRET=
# Optional dedicated HMAC secret for Core asset keypair derivation.
SPORE_ASSET_DERIVATION_SECRET=

# One-time Seeker Zero bootstrap (script only; keep false in normal runtime)
SPORE_BOOTSTRAP_SEEKER_ZERO=false
SPORE_BOOTSTRAP_SEEKER_ZERO_SGT=
SPORE_BOOTSTRAP_SEEKER_ZERO_WALLET=

SPORE_DEVNET_TEST_SGT_BOOTSTRAP_ENABLED=false
SPORE_DEVNET_APPROVED_PROGRAM_ID=
SPORE_DEVNET_TEST_SGT_MINT_AUTHORITY=
SPORE_DEVNET_TEST_SGT_METADATA_ADDRESS=
SPORE_DEVNET_TEST_SGT_GROUP_ADDRESS=
SPORE_DEVNET_TEST_SGT_MINT_AUTHORITY_SECRET=
SPORE_DEVNET_SPONSOR_SECRET=
SPORE_DEVNET_TESTER_FUNDING_TARGET_LAMPORTS=100000000

SPOR_SOCIAL_SECRET=
CRON_SECRET=
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
