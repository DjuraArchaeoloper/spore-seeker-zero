EXPO_PUBLIC_SPORE_API_URL=
EXPO_PUBLIC_SPORE_VISUAL_PREVIEW=false
# Allowed values: mainnet, devnet. QR payloads never select the network.
EXPO_PUBLIC_SPORE_SOLANA_CLUSTER=mainnet
# Public RPC URL matching EXPO_PUBLIC_SPORE_SOLANA_CLUSTER; never put a privileged server RPC credential here.
EXPO_PUBLIC_SPORE_RPC_URL=
# Logical organism-identity seed program id (compatibility). Server-era births do not call Anchor.
EXPO_PUBLIC_SPORE_PROGRAM_ID=
# server (default) | anchor_legacy
EXPO_PUBLIC_SPORE_REPRODUCTION_MODE=server
