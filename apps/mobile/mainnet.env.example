# MAINNET mobile environment for SPØR production.
# Public values only. Never place API/server secrets in a mobile build.
# NO MAINNET CUSTOM SPØR PROGRAM DEPLOYMENT IS REQUIRED.

EXPO_PUBLIC_SPORE_ENV=mainnet
EXPO_PUBLIC_SPORE_VISUAL_PREVIEW=false
EXPO_PUBLIC_SPORE_SOLANA_CLUSTER=mainnet
EXPO_PUBLIC_SPORE_REPRODUCTION_MODE=server

EXPO_PUBLIC_SPORE_API_URL=https://<PRODUCTION_API_HOST>
EXPO_PUBLIC_SPORE_RPC_URL=<PUBLIC_MAINNET_RPC_URL>

# Stable logical organism-identity namespace. This does not imply a deployed
# mainnet SPØR program in server reproduction mode.
EXPO_PUBLIC_SPORE_PROGRAM_ID=<STABLE_LOGICAL_NAMESPACE_PUBLIC_KEY>
