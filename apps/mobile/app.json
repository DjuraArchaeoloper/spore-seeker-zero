{
  "expo": {
    "name": "SPORE",
    "slug": "spore-seeker-zero",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "scheme": "spore",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPORE to scan a spore QR.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.spore.seekerzero",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ce594a7e-13e3-4e60-b78e-f8ea0138e79d"
      }
    }
  }
}
