{
  "expo": {
    "name": "SPOR",
    "slug": "spore-seeker-zero",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/spor-icon-v2.png",
    "platforms": [
      "android"
    ],
    "scheme": "spore",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPOR to scan a spore QR.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.spor.seekerzero",
      "adaptiveIcon": {
        "foregroundImage": "./assets/spor-adaptive-icon-v2.png",
        "backgroundColor": "#050607"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ce594a7e-13e3-4e60-b78e-f8ea0138e79d"
      }
    }
  }
}
