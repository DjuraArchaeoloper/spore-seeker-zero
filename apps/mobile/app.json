{
  "expo": {
    "name": "SPORE",
    "slug": "spore-seeker-zero",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "android"
    ],
    "scheme": "spore",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPORE to scan a spore QR.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.spore.seekerzero"
    }
  }
}
