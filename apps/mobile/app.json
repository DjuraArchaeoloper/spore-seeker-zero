{
  "expo": {
    "name": "SPØR",
    "slug": "spore-seeker-zero",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/spor-android-icon-1024-v5.png",
    "platforms": [
      "android"
    ],
    "scheme": "spore",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SPØR to scan a spore QR.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.spor.seekerzero",
      "icon": "./assets/spor-android-icon-1024-v5.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/spor-android-adaptive-foreground-v5.png",
        "backgroundImage": "./assets/spor-android-adaptive-background-v5.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "ce594a7e-13e3-4e60-b78e-f8ea0138e79d"
      }
    }
  }
}
