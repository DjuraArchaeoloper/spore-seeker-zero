EXPO_PUBLIC_SPORE_PROGRAM_ID=9HvZ7ckadQt38R1KxYPhP759yCCx4MRF8NBquV4HUUXZ
EXPO_PUBLIC_SPORE_REPRODUCTION_MODE=server

# Devnet may keep legacy Anchor/devnet tooling, but server reproduction is the default app path.
