# DEVNET-ONLY mobile environment for the fresh SPORE devnet.
# Mobile receives public configuration only. Never put API, sponsor, or mint-authority secrets here.

EXPO_PUBLIC_SPORE_API_URL=<DEVNET_API_URL>
EXPO_PUBLIC_SPORE_VISUAL_PREVIEW=false
EXPO_PUBLIC_SPORE_ENV=devnet
EXPO_PUBLIC_SPORE_SOLANA_CLUSTER=devnet
