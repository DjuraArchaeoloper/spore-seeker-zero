/**
 * SPORE Creature Asset Registry — mobile adapter shape reference.
 *
 * Shared art metadata lives in packages/shared/src/organismArt.ts.
 * Metro still requires static image paths, so the mobile adapter must use
 * literal require("../../../../packages/shared/assets/organisms/family/body.png")
 * paths, not dynamic template strings.
 *
 * Adding art should mean:
 * 1. add one shared family folder with the six biological PNGs
 * 2. add one shared CreatureFamilyArtDefinition entry
 * 3. add mobile static require() asset IDs that point at packages/shared
 * 4. intentionally update the genome body-form mapping only when approved
 */

import type { CreatureFamily, CreatureFamilyArtDefinition } from "@spore/shared";

export type CreatureLayer = "body" | "fins" | "core" | "tendrils" | "surface" | "glow";
type CreatureAssetSource = number;

export type CreatureLayerAssets = Readonly<Record<CreatureLayer, CreatureAssetSource>>;

export type CreatureFamilyDefinition = CreatureFamilyArtDefinition & {
  assets: CreatureLayerAssets;
};

export const EXAMPLE_CREATURE_FAMILY = {
  id: "silk-ray",
  layers: {
    body: "silk-ray/body.png",
    fins: "silk-ray/fins.png",
    core: "silk-ray/core.png",
    tendrils: "silk-ray/tendrils.png",
    surface: "silk-ray/surface.png",
    glow: "silk-ray/glow.png",
  },
  assets: {
    body: require("../../../../packages/shared/assets/organisms/silk-ray/body.png"),
    fins: require("../../../../packages/shared/assets/organisms/silk-ray/fins.png"),
    core: require("../../../../packages/shared/assets/organisms/silk-ray/core.png"),
    tendrils: require("../../../../packages/shared/assets/organisms/silk-ray/tendrils.png"),
    surface: require("../../../../packages/shared/assets/organisms/silk-ray/surface.png"),
    glow: require("../../../../packages/shared/assets/organisms/silk-ray/glow.png")
  },
  moustache: {
    center: [0.5078, 0.4902],
    width: 0.142,
    rotationDeg: 0
  },
  sensoryAnchors: [
    [0.43, 0.4],
    [0.57, 0.4],
    [0.405, 0.48],
    [0.595, 0.48],
    [0.44, 0.57],
    [0.56, 0.57],
    [0.47, 0.33],
    [0.53, 0.33]
  ]
} as const satisfies CreatureFamilyDefinition;
