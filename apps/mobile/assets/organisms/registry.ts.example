/**
 * SPORE Creature Asset Registry — shape reference.
 *
 * Metro requires static image paths. The runtime registry must use literal
 * require("./family/body.png") paths, not dynamic template strings.
 *
 * Adding art should mean:
 * 1. add a standardized family folder with the six biological PNGs
 * 2. add one CreatureFamilyDefinition entry
 * 3. intentionally update the genome body-form mapping only when approved
 */

import type { CreatureFamily } from "@spore/shared";

export type CreatureLayer = "body" | "fins" | "core" | "tendrils" | "surface" | "glow";
type CreatureAssetSource = number;
type PointPair = readonly [number, number];

export type CreatureLayerAssets = Record<CreatureLayer, CreatureAssetSource>;

export type CreatureFamilyDefinition = {
  id: CreatureFamily;
  assets: CreatureLayerAssets;
  moustache: {
    center: PointPair;
    width: number;
    rotationDeg: number;
  };
  sensoryAnchors: readonly PointPair[];
};

export const EXAMPLE_CREATURE_FAMILY = {
  id: "silk-ray",
  assets: {
    body: require("./silk-ray/body.png"),
    fins: require("./silk-ray/fins.png"),
    core: require("./silk-ray/core.png"),
    tendrils: require("./silk-ray/tendrils.png"),
    surface: require("./silk-ray/surface.png"),
    glow: require("./silk-ray/glow.png")
  },
  moustache: {
    center: [0.5078, 0.4902],
    width: 0.142,
    rotationDeg: 0
  },
  sensoryAnchors: [
    [0.43, 0.4],
    [0.57, 0.4],
    [0.405, 0.48],
    [0.595, 0.48],
    [0.44, 0.57],
    [0.56, 0.57],
    [0.47, 0.33],
    [0.53, 0.33]
  ]
} as const satisfies CreatureFamilyDefinition;
